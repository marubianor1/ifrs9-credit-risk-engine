# Python environments
.venv/
venv/
env/

# Secrets and local environment
.env
.env.*
!.env.example
secrets/
.streamlit/secrets.toml
*.pem
*.key
*.p12

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

