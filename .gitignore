.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.log

# MLflow and generated outputs
mlruns/
mlartifacts/

# Generated models and artifacts
models/*
!models/.gitkeep
artifacts/*
!artifacts/.gitkeep
reports/*
!reports/.gitkeep

# Data zones and large data files
data/download/
data/raw/*
data/bronze/*
data/silver/*
data/gold/*
